{
  "manifest_version": 3,
  "name": "Don't Be Late",
  "version": "0.1.0",
  "description": "Opens your Google Calendar meeting's waiting room shortly before it starts.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["identity", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Don't Be Late settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}

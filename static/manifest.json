{
  "manifest_version": 3,
  "name": "Don't Be Late",
  "version": "0.1.0",
  "description": "Opens your Google Calendar meeting's waiting room shortly before it starts.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "identity", "storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Don't Be Late settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
